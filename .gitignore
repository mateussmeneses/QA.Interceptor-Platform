node_modules/

# Build outputs
extension/dist/
packages/*/dist/

# Stray compiled output accidentally emitted next to TS sources
# (happens when `tsc` runs without `-p tsconfig.json`; the real output is dist/)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts

# TypeScript incremental cache
*.tsbuildinfo

# Test and coverage artifacts
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor local files
.DS_Store
Thumbs.db
desktop.ini

# VS Code workspace settings (keep extensions/launch for team, ignore personal)
.vscode/settings.json
.vscode/*.code-workspace

# JetBrains IDEs
.idea/
*.iml

# Environment files
.env
.env.local
.env.*.local

# Packed extension artifacts
*.crx
*.zip
*.xpi

# Sourcemap files generated at dist (already under extension/dist/)
extension/dist/